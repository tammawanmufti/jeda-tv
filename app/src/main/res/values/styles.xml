<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="JedaTimePicker" parent="android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:timePickerMode">spinner</item>
    </style>
    <style name="KeypadBtn">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/keypad_text</item>
        <item name="android:background">@drawable/keypad_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
